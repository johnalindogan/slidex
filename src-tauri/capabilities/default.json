{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for SlideShowPro desktop wrapper",
  "windows": [
    "main",
    "playlist"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:allow-create-webview-window",
    "core:path:default",
    "core:app:default",
    "dialog:default",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "allow-get-launch-paths",
    "allow-read-media-file",
    "allow-media-file-size",
    "allow-register-allowed-paths",
    "allow-list-folder-media",
    "allow-read-text-file",
    "allow-open-playlist-window",
    "allow-close-playlist-window",
    "allow-focus-playlist-window",
    "allow-write-export-file",
    "allow-read-crop-sidecar",
    "allow-write-crop-sidecar",
    "allow-delete-crop-sidecar",
    "allow-save-named-playlist",
    "allow-list-named-playlists",
    "allow-read-named-playlist",
    "allow-rename-named-playlist",
    "allow-delete-named-playlist",
    "allow-paths-exist",
    "allow-cast-discover",
    "allow-cast-network-fingerprint",
    "allow-cast-connect",
    "allow-cast-set-playlist",
    "allow-cast-load",
    "allow-cast-pause",
    "allow-cast-play",
    "allow-cast-disconnect",
    "allow-cast-status",
    "allow-cast-firewall-status",
    "allow-cast-log-path",
    "allow-cast-log-dur-fallback",
    "allow-slidex-save-done"
  ]
}
